{
  "name": "aquarium-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build --workspace @aquarium/controller && npm run build --workspace @aquarium/web",
    "build:packages": "npm run build --workspace @aquarium/contracts && npm run build --workspace @aquarium/domain && npm run build --workspace @aquarium/esp-protocol && npm run build --workspace @aquarium/fake-esp",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "dev": "concurrently --names controller,web --prefix-colors cyan,magenta \"npm:dev:controller\" \"npm:dev:web\"",
    "dev:controller": "npm run dev --workspace @aquarium/controller",
    "dev:web": "npm run dev --workspace @aquarium/web",
    "firmware:release": "node tools/firmware-release.mjs",
    "production:deploy": "node tools/production-deploy.mjs",
    "lint": "eslint .",
    "pretest:critical": "npm run build:packages",
    "pretest:e2e": "npm run build && npm run typecheck:e2e",
    "pretest:integration": "npm run build:packages",
    "pretest:unit": "npm run build:packages",
    "stack:test:down": "docker compose --file compose.local.yaml --profile test down",
    "stack:test:status": "docker compose --file compose.local.yaml --profile test ps",
    "stack:test:up": "docker compose --file compose.local.yaml --profile test up --build --detach --wait --wait-timeout 180",
    "storage": "npm run storage --workspace @aquarium/controller --",
    "test": "npm run test:unit",
    "test:critical": "vitest run --config vitest.critical.config.ts",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.config.ts && node --test tools/*.test.mjs",
    "test:watch": "vitest",
    "pretypecheck": "npm run build:packages",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:e2e",
    "typecheck:e2e": "tsc --project tests/e2e/tsconfig.json",
    "verify": "npm run check && npm run test:critical"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
